{
  "opencollection": "1.0.0",
  "info": {
    "name": "SeatGeek Platform Events Taxonomies API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "client_id",
      "value": "{{client_id}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Taxonomies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Taxonomies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seatgeek.com/2/taxonomies"
          },
          "docs": "Returns the available taxonomy categories used to classify events and performers."
        }
      ]
    }
  ],
  "bundled": true
}